# Suni AI 环境变量配置
# ⚠️ 重要：复制此文件为 .env 并填入你的真实密钥
# 永远不要将包含真实密钥的 .env 文件上传到 GitHub！

# ============================================
# 必需配置
# ============================================

# JWT 密钥（用于用户认证）
# 生成方式: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# 管理员邮箱（用于管理后台访问）
ADMIN_EMAIL=your-admin-email@example.com

# ============================================
# 邮件服务配置（用于验证码发送）
# ============================================

# 163 邮箱配置示例
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your-email@163.com
SMTP_PASSWORD=your-auth-code
FROM_EMAIL=your-email@163.com

# Gmail 配置示例（需要翻墙）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# AI 模型配置
# ============================================

# 阿里云百炼 API Key（如果使用阿里云模型）
ALIYUN_API_KEY=your-aliyun-api-key

# DeepSeek API Key（如果使用 DeepSeek 模型）
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI API Key（如果使用 OpenAI 模型）
OPENAI_API_KEY=your-openai-api-key

# Kimi API Key（如果使用 Kimi 模型）
KIMI_API_KEY=your-kimi-api-key

# ============================================
# OpenClaw Gateway 配置（可选）
# ============================================

OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# ============================================
# 飞书集成配置（可选）
# ============================================

FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# ============================================
# 第三方服务配置（可选）
# ============================================

# Tavily 搜索 API Key（用于网络搜索功能）
TAVILY_API_KEY=your-tavily-api-key
